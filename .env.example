# ---- Shared (Web + Workshop) ----
# Supabase (same project as ReRoll)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ---- Web (Next.js / apps/web) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Where to call the workshop service (Magic Mirror + Tavern Bard)
NEXT_PUBLIC_WORKSHOP_BASE_URL=http://localhost:8001
# Where to call the existing ReRoll backend
NEXT_PUBLIC_REROLL_BASE_URL=https://backend-production-4abc.up.railway.app

# ---- Workshop (FastAPI / services/workshop) ----
# Magic Mirror — portrait (always on; uses fal.ai Flux 1.1 Pro Ultra)
FAL_KEY=

# Magic Mirror — sprite (OPTIONAL).
# Sprites are generated by PixelLab — a model that produces true low-res
# JRPG-style pixel art. If you don't want sprites (or don't have a PixelLab
# key), leave SPRITES_ENABLED=false. Portraits still work standalone, the
# UI just doesn't show a sprite preview and the party screen falls back to
# portraits.
SPRITES_ENABLED=false
PIXELLAB_API_KEY=
PIXELLAB_BASE_URL=https://api.pixellab.ai/v1
SPRITE_SIZE=128

# Tavern Bard — Suno reseller (e.g. sunoapi.com)
SUNO_API_KEY=
SUNO_BASE_URL=https://api.sunoapi.com/api/v1
# Claude for lyric generation (reuse the ReRoll key)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Storage bucket names (created via Supabase Studio or migration)
PORTRAIT_BUCKET=portraits
SONG_BUCKET=bard-songs
# CORS — local dev
FRONTEND_ORIGIN=http://localhost:3000
